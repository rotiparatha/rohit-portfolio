# Copy to .env.local and fill in.

# Google account(s) allowed into /admin (comma-separated)
ADMIN_EMAIL=
# OAuth client from Google Cloud Console > Google Auth Platform > Clients (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string, at least 32 characters, used to sign the admin session cookie
SESSION_SECRET=
# Optional: public URL of the site (e.g. https://rohitparashar.com) if the host's proxy hides it;
# the Google redirect URI is SITE_URL + /api/auth/google/callback
SITE_URL=
# Optional: raises the GitHub API limit from 60 to 5000 calls/hour
GITHUB_TOKEN=
# Optional: where content.json and resume.pdf are stored (default: ./data)
DATA_DIR=
